<UserControl x:Class="VideoTriage.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VideoTriage.App;component/Resources/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="SETTINGS" Margin="{StaticResource SectionGap}" Style="{StaticResource SectionHeader}" />

        <TextBlock Margin="{StaticResource FieldLabelMargin}" Text="Candidate BPP threshold" />
        <TextBox Text="{Binding CandidateBppThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
        <TextBlock Text="Allowed range 0–1" Style="{StaticResource Caption}" />

        <TextBlock Margin="{StaticResource FieldLabelMargin}" Text="Minimum free space (GB)" />
        <TextBox Text="{Binding MinimumFreeGigabytes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
        <TextBlock Text="At least 1 GB" Style="{StaticResource Caption}" />

        <TextBlock Margin="{StaticResource FieldLabelMargin}" Text="Original deletion" />
        <ComboBox ItemsSource="{Binding DeleteModes}"
                  SelectedItem="{Binding DeleteMode}" />
        <CheckBox Margin="0,6,0,0"
                  Content="I confirm permanent deletion"
                  Foreground="{DynamicResource DangerBrush}"
                  IsChecked="{Binding ConfirmPermanentDelete}" />

        <CheckBox Margin="0,10,0,0"
                  Content="Deep verification"
                  IsChecked="{Binding DeepVerify}" />
        <CheckBox Margin="0,6,0,0"
                  Content="Embed poster thumbnail"
                  IsChecked="{Binding EmbedPoster}" />
        <CheckBox Margin="0,6,0,0"
                  IsChecked="{Binding DryRun}">
            <TextBlock Text="Dry run: no encoding or file changes"
                       TextWrapping="Wrap" />
        </CheckBox>

        <TextBlock Margin="0,8,0,0"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ValidationMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Recursive toggle deferred to Phase 3 (Queue UX plan) -->
    </StackPanel>
</UserControl>
