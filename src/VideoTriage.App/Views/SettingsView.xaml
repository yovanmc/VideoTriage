<UserControl x:Class="VideoTriage.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Settings" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

        <TextBlock Margin="0,10,0,4" Text="Candidate BPP threshold" />
        <TextBox Text="{Binding CandidateBppThreshold, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,10,0,4" Text="Minimum free space (GB)" />
        <TextBox Text="{Binding MinimumFreeGigabytes, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Margin="0,10,0,4" Text="Original deletion" />
        <ComboBox ItemsSource="{Binding DeleteModes}"
                  SelectedItem="{Binding DeleteMode}" />
        <CheckBox Margin="0,6,0,0"
                  Content="I confirm permanent deletion"
                  Foreground="#FF6B6B"
                  IsChecked="{Binding ConfirmPermanentDelete}" />

        <CheckBox Margin="0,10,0,0"
                  Content="Deep verification"
                  IsChecked="{Binding DeepVerify}" />
        <CheckBox Margin="0,6,0,0"
                  Content="Embed poster thumbnail"
                  IsChecked="{Binding EmbedPoster}" />
        <CheckBox Margin="0,6,0,0"
                  Content="Dry run: no encoding or file changes"
                  IsChecked="{Binding DryRun}" />

        <TextBlock Margin="0,8,0,0"
                   Foreground="#FF6B6B"
                   TextWrapping="Wrap"
                   Text="{Binding ValidationMessage}" />
        <Button Margin="0,8,0,0"
                Content="Save settings"
                Command="{Binding SaveCommand}" />
    </StackPanel>
</UserControl>
